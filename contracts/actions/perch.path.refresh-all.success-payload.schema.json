{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perch.local/schemas/actions/perch.path.refresh-all/1.0/success-payload.json",
  "title": "perch.path.refresh-all success payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["aggregateRevision", "checkedAt", "summary", "items"],
  "properties": {
    "aggregateRevision": { "type": "integer", "minimum": 1 },
    "checkedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "available", "missing", "denied", "invalid"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "available": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "inspection"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
          "inspection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "kind", "gitRoot", "projectType", "suggestedName", "checkedAt"],
            "properties": {
              "status": { "enum": ["available", "missing", "denied", "invalid"] },
              "kind": { "enum": ["file", "directory", "other", "unknown"] },
              "gitRoot": { "type": "boolean" },
              "projectType": { "type": "string", "maxLength": 30 },
              "suggestedName": { "type": "string", "maxLength": 120 },
              "checkedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
            }
          }
        }
      }
    }
  }
}
