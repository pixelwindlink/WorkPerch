{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://perch.local/schemas/actions/perch.view.upsert/2.0/request-payload.json", "title": "perch.view.upsert request payload", "type": "object", "additionalProperties": false, "required": ["item", "expectedRevision"], "properties": { "expectedRevision": { "type": "integer", "minimum": 0 }, "item": { "type": "object", "additionalProperties": false, "required": ["name", "scope", "query", "tagIds", "pathStatus", "sort"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "scope": { "enum": ["all", "paths", "notes", "projects"] }, "query": { "type": "string", "maxLength": 200 }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "pathStatus": { "enum": ["any", "available", "missing", "denied", "invalid"] }, "sort": { "enum": ["smart", "recent", "frequent", "name", "updated"] } } } }
