{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perch.local/schemas/actions/perch.path.upsert/2.0/request-payload.json",
  "title": "perch.path.upsert request payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "expectedRevision"],
  "properties": {
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "item": { "type": "object", "additionalProperties": false, "required": ["name", "path", "description", "pinned"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "tags": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }, "groupId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "group": { "type": "string", "minLength": 1, "maxLength": 80 }, "groupColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "description": { "type": "string", "maxLength": 500 }, "pinned": { "type": "boolean" } } }
  }
}
