{
  "$schema": "https://generic-engines.local/schemas/governance/engine-manifest-1.2.json",
  "schemaVersion": "1.2",
  "id": "work-perch",
  "name": "WorkPerch",
  "version": "2.2.0",
  "classification": "engine",
  "description": "管理本地开发路径、速记、项目入口、共享标签、使用视图与路径状态，并通过注入 EngineClient 委托独立 Project Launcher 安全启动项目。",
  "architecture": {
    "authority": "openspec/architecture/generic-engine-runtime-architecture.md"
  },
  "protocol": {
    "name": "generic-engines/engine-message",
    "supportedVersions": ["1.0"],
    "preferredVersion": "1.0",
    "envelopeSchema": "https://generic-engines.local/schemas/engine-message/1.0/envelope.json"
  },
  "actions": {
    "catalog": "contracts/action-catalog.json",
    "describe": "engine.describe",
    "health": "system.health"
  },
  "provider": {
    "spiVersion": "1.0",
    "entrypoint": "src/engine/provider.mjs",
    "capabilities": ["manifest", "action-catalog", "create-engine"],
    "lifecycle": ["start", "readiness", "health", "quiesce", "shutdown"]
  },
  "runtime": {
    "hostModes": ["standalone", "in-process", "local-process"],
    "engineClient": {
      "mode": "injected",
      "dependencies": [
        {
          "engine": "project-launcher",
          "actions": [
            "launcher.definition.upsert",
            "launcher.project.start",
            "launcher.project.stop",
            "launcher.runtime.get"
          ],
          "reason": "Perch Desktop delegates structured project launch configuration and owned process lifecycle to Project Launcher while standalone Perch CRUD remains available without injection."
        }
      ]
    },
    "planes": {
      "control": {
        "providerLifecycle": true
      },
      "data": {
        "dispatcher": "src/inbound/dispatcher.mjs",
        "routerBoundary": true
      },
      "observability": {
        "lifecycleEvents": "runtime-derived",
        "payloadPolicy": "metadata-only"
      }
    }
  },
  "transports": ["cli", "http", "in-process"],
  "cli": {
    "command": ["node", "cli.mjs"],
    "acceptsStdin": true,
    "messageFileFlag": "--message-file"
  },
  "state": {
    "mode": "single-writer",
    "owner": "WorkPerch Server or an explicitly isolated Standalone Exclusive CLI process",
    "runtimeData": "runtime_data",
    "conformance": {
      "temporaryRuntimeEnv": "RUNTIME_DATA_DIR"
    }
  },
  "consumers": {
    "human": {
      "readme": "README.md",
      "architectureDoc": "architecture/README.md"
    },
    "program": {
      "protocol": {
        "name": "generic-engines/engine-message",
        "version": "1.0"
      },
      "actions": [
        "engine.describe",
        "system.health",
        "perch.snapshot.get",
        "perch.group.upsert",
        "perch.group.delete",
        "perch.tag.upsert",
        "perch.tag.delete",
        "perch.path.upsert",
        "perch.path.delete",
        "perch.path.inspect",
        "perch.path.refresh-all",
        "perch.path.preflight",
        "perch.path.batch-upsert",
        "perch.path.repair",
        "perch.note.upsert",
        "perch.note.delete",
        "perch.project.upsert",
        "perch.project.delete",
        "perch.project.probe",
        "perch.project.launch.configure",
        "perch.project.launch.start",
        "perch.project.launch.stop",
        "perch.project.launch.status",
        "perch.entry.usage.record",
        "perch.view.upsert",
        "perch.view.delete",
        "perch.backup.export",
        "perch.backup.import"
      ]
    },
    "agent": {
      "skills": [
        {
          "name": "operate-perch",
          "path": ".agents/skills/operate-perch/SKILL.md"
        },
        {
          "name": "register-project-entry",
          "path": ".agents/skills/register-project-entry/SKILL.md",
          "compatibilityPaths": [
            "skills/register-project-entry/SKILL.md"
          ]
        }
      ]
    }
  }
}
