{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.local/schemas/actions/dashboard.note.upsert/1.0/success-payload.json",
  "title": "dashboard.note.upsert success payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["aggregateRevision", "item"],
  "properties": {
    "aggregateRevision": { "type": "integer", "minimum": 1 },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "content", "pinned", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "content": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "pinned": { "type": "boolean" },
        "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
      }
    }
  }
}
