{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://dashboard.local/schemas/actions/dashboard.project.upsert/2.0/request-payload.json", "title": "dashboard.project.upsert request payload", "type": "object", "additionalProperties": false, "required": ["item", "expectedRevision"], "properties": { "expectedRevision": { "type": "integer", "minimum": 0 }, "item": { "type": "object", "additionalProperties": false, "required": ["name", "type", "label", "description", "path", "url", "port", "command", "pinned"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "type": { "enum": ["engine", "candidate", "tool", "application", "workspace", "archive", "other"] }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" }, "url": { "type": "string", "maxLength": 2048, "pattern": "^(?:https?://.*)?$" }, "port": { "type": "integer", "minimum": 0, "maximum": 65535 }, "command": { "type": "string", "maxLength": 2000 }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "tags": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 50 } }, "pinned": { "type": "boolean" } } } }
