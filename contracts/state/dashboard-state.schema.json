{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.local/schemas/state/dashboard-state/2.0.json",
  "title": "Dashboard Engine aggregate state 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "aggregateRevision", "tags", "paths", "notes", "projects", "savedViews", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "aggregateRevision": { "type": "integer", "minimum": 0 },
    "tags": { "type": "array", "maxItems": 500, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "color", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 }, "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } } },
    "paths": { "type": "array", "maxItems": 5000, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "path", "tagIds", "description", "pinned", "usage", "inspection", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "description": { "type": "string", "maxLength": 500 }, "pinned": { "type": "boolean" }, "usage": { "type": "object", "additionalProperties": false, "required": ["count", "lastUsedAt"], "properties": { "count": { "type": "integer", "minimum": 0 }, "lastUsedAt": { "type": ["string", "null"], "minLength": 20, "maxLength": 40 } } }, "inspection": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["status", "kind", "gitRoot", "projectType", "suggestedName", "checkedAt"], "properties": { "status": { "enum": ["available", "missing", "denied", "invalid"] }, "kind": { "enum": ["file", "directory", "other", "unknown"] }, "gitRoot": { "type": "boolean" }, "projectType": { "type": "string", "maxLength": 30 }, "suggestedName": { "type": "string", "maxLength": 120 }, "checkedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } }] }, "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 }, "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } } },
    "notes": { "type": "array", "maxItems": 5000, "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "content", "tagIds", "pinned", "usage", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "content": { "type": "string", "minLength": 1, "maxLength": 10000 }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "pinned": { "type": "boolean" }, "usage": { "type": "object", "additionalProperties": false, "required": ["count", "lastUsedAt"], "properties": { "count": { "type": "integer", "minimum": 0 }, "lastUsedAt": { "type": ["string", "null"], "minLength": 20, "maxLength": 40 } } }, "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 }, "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } } },
    "projects": { "type": "array", "maxItems": 2000, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "type", "label", "description", "path", "url", "port", "command", "tagIds", "pinned", "usage", "inspection", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "type": { "enum": ["engine", "candidate", "tool", "application", "workspace", "archive", "other"] }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" }, "url": { "type": "string", "maxLength": 2048, "pattern": "^(?:https?://.*)?$" }, "port": { "type": "integer", "minimum": 0, "maximum": 65535 }, "command": { "type": "string", "maxLength": 2000 }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "pinned": { "type": "boolean" }, "usage": { "type": "object", "additionalProperties": false, "required": ["count", "lastUsedAt"], "properties": { "count": { "type": "integer", "minimum": 0 }, "lastUsedAt": { "type": ["string", "null"], "minLength": 20, "maxLength": 40 } } }, "inspection": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["status", "kind", "gitRoot", "projectType", "suggestedName", "checkedAt"], "properties": { "status": { "enum": ["available", "missing", "denied", "invalid"] }, "kind": { "enum": ["file", "directory", "other", "unknown"] }, "gitRoot": { "type": "boolean" }, "projectType": { "type": "string", "maxLength": 30 }, "suggestedName": { "type": "string", "maxLength": 120 }, "checkedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } }] }, "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 }, "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } } },
    "savedViews": { "type": "array", "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "scope", "query", "tagIds", "pathStatus", "sort", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "scope": { "enum": ["all", "paths", "notes", "projects"] }, "query": { "type": "string", "maxLength": 200 }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "pathStatus": { "enum": ["any", "available", "missing", "denied", "invalid"] }, "sort": { "enum": ["smart", "recent", "frequent", "name", "updated"] }, "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 }, "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } } },
    "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
  }
}
