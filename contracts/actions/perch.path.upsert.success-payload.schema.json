{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perch.local/schemas/actions/perch.path.upsert/2.0/success-payload.json",
  "title": "perch.path.upsert success payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["aggregateRevision", "item"],
  "properties": {
    "aggregateRevision": { "type": "integer", "minimum": 1 },
    "item": { "type": "object", "additionalProperties": false, "required": ["id", "name", "path", "tagIds", "description", "pinned", "usage", "inspection", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "description": { "type": "string", "maxLength": 500 }, "pinned": { "type": "boolean" }, "usage": { "type": "object", "additionalProperties": false, "required": ["count", "lastUsedAt"], "properties": { "count": { "type": "integer", "minimum": 0 }, "lastUsedAt": { "type": ["string", "null"], "minLength": 20, "maxLength": 40 } } }, "inspection": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["status", "kind", "gitRoot", "projectType", "suggestedName", "checkedAt"], "properties": { "status": { "enum": ["available", "missing", "denied", "invalid"] }, "kind": { "enum": ["file", "directory", "other", "unknown"] }, "gitRoot": { "type": "boolean" }, "projectType": { "type": "string", "maxLength": 30 }, "suggestedName": { "type": "string", "maxLength": 120 }, "checkedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } }] }, "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 }, "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } }
  }
}
