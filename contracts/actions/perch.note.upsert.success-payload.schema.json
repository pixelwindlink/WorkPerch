{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://perch.local/schemas/actions/perch.note.upsert/2.0/success-payload.json", "title": "perch.note.upsert success payload", "type": "object", "additionalProperties": false, "required": ["aggregateRevision", "item"], "properties": { "aggregateRevision": { "type": "integer", "minimum": 1 }, "item": { "type": "object", "additionalProperties": false, "required": ["id", "title", "content", "tagIds", "pinned", "usage", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "content": { "type": "string", "minLength": 1, "maxLength": 10000 }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "pinned": { "type": "boolean" }, "usage": { "type": "object", "additionalProperties": false, "required": ["count", "lastUsedAt"], "properties": { "count": { "type": "integer", "minimum": 0 }, "lastUsedAt": { "type": ["string", "null"], "minLength": 20, "maxLength": 40 } } }, "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 }, "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } } }
