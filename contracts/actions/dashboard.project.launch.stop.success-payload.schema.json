{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.local/schemas/actions/dashboard.project.launch.stop/2.0/success-payload.json",
  "title": "dashboard.project.launch.stop success payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "run"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "projectId", "status", "pid", "startedAt", "endedAt", "exitCode"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
        "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
        "status": { "enum": ["stopped", "failed"] },
        "pid": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "endedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "exitCode": { "type": ["integer", "null"] }
      }
    }
  }
}
