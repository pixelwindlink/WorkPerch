{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://perch.local/schemas/actions/perch.project.upsert/2.0/success-payload.json", "title": "perch.project.upsert success payload", "type": "object", "additionalProperties": false, "required": ["aggregateRevision", "item"], "properties": { "aggregateRevision": { "type": "integer", "minimum": 1 }, "item": { "type": "object", "additionalProperties": false, "required": ["id", "name", "type", "label", "description", "path", "url", "port", "command", "tagIds", "pinned", "usage", "inspection", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "type": { "enum": ["engine", "candidate", "tool", "application", "workspace", "archive", "other"] }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" }, "url": { "type": "string", "maxLength": 2048, "pattern": "^(?:https?://.*)?$" }, "port": { "type": "integer", "minimum": 0, "maximum": 65535 }, "command": { "type": "string", "maxLength": 2000 }, "tagIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } }, "pinned": { "type": "boolean" }, "usage": { "type": "object", "additionalProperties": false, "required": ["count", "lastUsedAt"], "properties": { "count": { "type": "integer", "minimum": 0 }, "lastUsedAt": { "type": ["string", "null"], "minLength": 20, "maxLength": 40 } } }, "inspection": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["status", "kind", "gitRoot", "projectType", "suggestedName", "checkedAt"], "properties": { "status": { "enum": ["available", "missing", "denied", "invalid"] }, "kind": { "enum": ["file", "directory", "other", "unknown"] }, "gitRoot": { "ty