{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perch.local/schemas/actions/perch.project.launch.status/2.0/success-payload.json",
  "title": "perch.project.launch.status success payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["launcherRevision", "definitions", "runs"],
  "properties": {
    "launcherRevision": { "type": "integer", "minimum": 0 },
    "definitions": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "cwd", "executable", "args", "createdAt", "updatedAt"],
        "properties": {
          "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
          "cwd": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" },
          "executable": { "type": "string", "minLength": 1, "maxLength": 512 },
          "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 2048 } },
          "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 },
          "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
        }
      }
    },
    "runs": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "projectId", "status", "pid", "startedAt", "endedAt", "exitCode"],
        "properties": {
          "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
          "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
          "status": { "enum": ["running", "stopped", "failed", "stale"] },
          "pid": { "type": "integer", "minimum": 1 },
          "startedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
          "endedAt": { "type": ["string", "null"], "minLength": 20, "maxLength": 40 },
          "exitCode": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
