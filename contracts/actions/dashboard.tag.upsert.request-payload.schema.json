  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://dashboard.local/schemas/actions/dashboard.tag.upsert/2.0/request-payload.json", "title": "dashboard.tag.upsert request payload", "type": "object", "additionalProperties": false, "required": ["item", "expectedRevision"], "properties": { "expectedRevision": { "type": "integer", "minimum": 0 }, "item": { "type": "object", "additionalProperties": false, "required": ["name", "color"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } } } }
