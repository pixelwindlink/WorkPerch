{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.local/schemas/actions/dashboard.note.upsert/1.0/request-payload.json",
  "title": "dashboard.note.upsert request payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "expectedRevision"],
  "properties": {
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content", "pinned"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "content": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "pinned": { "type": "boolean" }
      }
    }
  }
}
