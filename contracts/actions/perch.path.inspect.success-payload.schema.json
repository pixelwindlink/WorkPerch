{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://perch.local/schemas/actions/perch.path.inspect/2.0/success-payload.json", "title": "perch.path.inspect success payload", "type": "object", "additionalProperties": false, "required": ["aggregateRevision", "kind", "id", "inspection"], "properties": { "aggregateRevision": { "type": "integer", "minimum": 1 }, "kind": { "enum": ["path", "project"] }, "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" }, "inspection": { "type": "object", "additionalProperties": false, "required": ["status", "kind", "gitRoot", "projectType", "suggestedName", "checkedAt"], "properties": { "status": { "enum": ["available", "missing", "denied", "invalid"] }, "kind": { "enum": ["file", "directory", "other", "unknown"] }, "gitRoot": { "type": "boolean" }, "projectType": { "type": "string", "maxLength": 30 }, "suggestedName": { "type": "string", "maxLength": 120 }, "checkedAt": { "type": "string", "minLength": 20, "maxLength": 40 } } } }
}
